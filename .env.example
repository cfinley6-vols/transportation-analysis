# Configuration template for the Transit Analysis app.
# Copy this file to ".env" and change any values you need:   cp .env.example .env
# Every setting is optional; the defaults below are what the app uses with no .env file.
# The app uses a local SQLite file, so there are NO passwords, keys, or connection strings.
# Never commit your real .env file (it is listed in .gitignore).

# Port the web server listens on (open http://127.0.0.1:<PORT>/ in a browser)
PORT=8000

# Path to the SQLite database file (default: transit.db in the project folder)
# TRANSIT_DB_PATH=./transit.db

# Set to 1 to print raw database errors in the terminal (never sent to the browser)
TRANSIT_DEBUG=0
